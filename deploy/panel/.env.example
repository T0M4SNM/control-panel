# Copia este archivo como .env en el servidor (deploy/panel/.env) y rellénalo.
# El .env nunca se sube al repo.

# Contraseña de la base de datos. Genera una larga, p. ej. en el servidor: openssl rand -hex 24
DB_PASSWORD=

# Versión de las imágenes: latest o el hash de un commit de main
IMAGE_TAG=latest

# Primer administrador: se crea solo si la base de datos está vacía. Después puedes borrar la contraseña de aquí.
APP_BOOTSTRAP_WORKSPACE_NAME=Principal
APP_BOOTSTRAP_ADMIN_EMAIL=
# Mínimo 12 caracteres
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=Tomás

# Web Push. Genera las claves una vez con: npx web-push generate-vapid-keys
APP_PUSH_VAPID_PUBLIC_KEY=
APP_PUSH_VAPID_PRIVATE_KEY=
APP_PUSH_SUBJECT=mailto:
