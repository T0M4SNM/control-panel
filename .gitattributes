# Archivos que se ejecutan o se leen en Linux (servidor y contenedores): siempre con fin de línea LF,
# aunque se clone en Windows. Con CRLF, bash falla con «$'\r': command not found».
*.sh text eol=lf
deploy/** text eol=lf
Caddyfile text eol=lf
*.caddy text eol=lf
Dockerfile text eol=lf
mvnw text eol=lf
