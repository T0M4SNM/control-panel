# Copia este archivo como .env y rellena los valores. El .env nunca se sube al repo.

# Primer administrador: se crea al arrancar solo si la base de datos no tiene ningún usuario.
# Una vez creado, puedes quitar estas variables.
APP_BOOTSTRAP_WORKSPACE_NAME=Principal
APP_BOOTSTRAP_ADMIN_EMAIL=
# Mínimo 12 caracteres
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=

# Web Push: claves VAPID para las notificaciones push de la PWA.
# Genera un par una sola vez con: npx web-push generate-vapid-keys
# La privada es secreta. Si cambias las claves, los dispositivos tendrán que volver a suscribirse.
APP_PUSH_VAPID_PUBLIC_KEY=
APP_PUSH_VAPID_PRIVATE_KEY=
# Contacto para los servicios de push (Google, Mozilla, Apple)
APP_PUSH_SUBJECT=mailto:
